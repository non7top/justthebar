{
  "hide_explorer_taskbar": true,
  "bars": [
    { "monitor": 0, "edge": "right", "size": 200 },
    { "monitor": 1, "edge": "left", "size": 120 }
  ],
  "start": { "enabled": true, "image": "start-button_large.png" },
  "tray": { "enabled": true, "bar": 0 },
  "clock": { "format": "hh:mm:ss\nDDD, dd MMM", "months": 3 },
  "widgets": ["language", "network", "volume", "battery"],
  "pins": [
    { "name": "Notepad", "path": "C:\\Windows\\notepad.exe" }
  ],
  "groups": [
    { "name": "PuTTY", "exes": ["putty.exe", "puttyportable.exe"] }
  ]
}
